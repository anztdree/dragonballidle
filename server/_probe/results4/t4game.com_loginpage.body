   <script type="text/javascript">
	// var _bdhmProtocol = (("https:" == document.location.protocol) ? " https://" : " http://");
	// document.write(unescape("%3Cscript src='" + _bdhmProtocol + "hm.baidu.com/h.js%3F27f5321ed84b9a29a9cac37ce84fc0d0' type='text/javascript'%3E%3C/script%3E"));

    /*<![CDATA[*/
    var contextPath = /*[[@{/}]]*/ '';
    /*]]>*/

    $('#username').focus(function(){
        $('#dv_username').hide();
    });
    $('#password').focus(function(){
        $('#dv_password').hide();
    });


    function login() {
        $('#dv_username').hide();
        $('#dv_password').hide();

        // 校验用户名和密码是否输入正确
        if ($('#username').val() == '') {
            $('#dv_username').show().html('* 请输入用户名')
        } else if ($('#username').val().length<6 || $('#username').val().length >12) {
            $('#dv_username').show().html('* 请输入6-12位用户名')
        } else if ($('#password').val() == '') {
            $('#dv_password').show().html('* 请输入密码')
        }  else if ($('#password').val().length<6 || $('#password').val().length >12) {
            $('#dv_password').show().html('* 请输入6-12位密码')
        } else {
            var username = $('#username').val();
            var password = $('#password').val();

            $.ajax({
                url:contextPath+'service/ucenter/login',
                contentType:"application/x-www-form-urlencoded; charset=utf-8",
                async:false,
                type:'post',
                data:{
                    username:username,
                    password:password
                    },
                success:function(data){
                    data = JSON.parse(data);
                    if (data.state) {
                        //location.href = "http://www.t4game.com/";
                        location.href = contextPath+'/';
                    } else {
                        alert(data.msg);
                    }

                }
            })
        }
    }

   </script>

