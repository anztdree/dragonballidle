              <div class="form-cont">
                  <form method="post" action="http://t4game.com:80/service/ucenter/login" id="form1">
                      <div class="form-list">
                          <label for="username">用户名</label>
                          <input type="text" name="username" id="username" onkeyup="value=value.replace(/[^\w\.\/]/ig,'')" placeholder="6-12位字母和数字的组合">
                          <div class="dv_username input-error" style="color: red" id="dv_username"></div>
                      </div>
                      <br/><br/>
                      <div class="form-list">
                          <label for="password">登录密码</label>
                          <input type="password" name="password" id="password" onkeyup="value=value.replace(/[^\w\.\/]/ig,'')" placeholder="6-12位字母和数字的组合">
                          <div class="dv_password input-error" style="color: red" id="dv_password"></div>
                      </div>
                      <br/><br/>
                      <div class="form-list">
                          <div class="dv_err input-error" style="color: red" id="dv_err"> </div>
                      </div>
                      <div class="form-list">
                      </div>
                      <br/><br/>
                      <button type="button" id="login_btn" class="login-btn" onclick="login()">登&nbsp;录</button>
                  </form>
              </div>
          </div>

