    .loginCont{padding:44px 55px 19px 46px;border:#c6c6c6 solid 1px; float:left; display:inline; margin-top:7px; width:877px;}
    .loginCont h2{background:url(http://t4game.com:80/view/front/images/font18.jpg) no-repeat; height:37px;border-bottom:#d5d5d5 solid 1px; margin-bottom:17px;}
    .loginCont .Prompt{ background:url(http://t4game.com:80/view/front/images/line4.jpg) no-repeat left bottom; height:27px; color:#6d6d6d}
    .loginCont .loginfont{ line-height:2.5; color:#4a4a4a;}
    .loginCont .loginfont a{ position:relative;}
    .loginCont .loginfont a i{ background:url(http://t4game.com:80/view/front/images/djdt.jpg) no-repeat 5px; width:28px; height:31px; display:inline-block; position:absolute; left:8px;}
    .loginCont .loginfont em{ background:url(http://t4game.com:80/view/front/images/map.jpg) no-repeat; width:708px; height:338px; position:relative;display:inline-block;}
    .loginCont .loginfont em a{ position:absolute; left:322px; top:100px; display:inline-block; width:80px; height:30px;}
    .loginCont .loginfont img{ border:#b7b7b7 solid 1px;}
    .loginCont .loginfont a{color:#4a4a4a;}
    .loginCont .loginfont a:hover{ color:#a40000; text-decoration:none}


    .login-btn {
      display: block;
      margin:0 auto;
      width: 150px;
      height: 35px;
      background: #fd8144;
      border: none;
      border-radius: 5px;
      color: #fff;
  }

  label {
      display: inline-block;
      max-width: 100%;
