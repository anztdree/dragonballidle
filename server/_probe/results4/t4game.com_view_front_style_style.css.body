/*road*/
.road{padding:55px 50px 22px 44px;border:#c6c6c6 solid 1px; float:left; display:inline; margin-top:7px; width:671px; position:relative;}
.road .roadicon{ position:absolute; top:135px; right:78px;}
.road h2{ background:url(../images/font8.jpg) no-repeat; height:35px; border-bottom:#d5d5d5 solid 1px;}
.road .roadC{ margin:55px 0 0  75px; padding:0 0 20px 0; color:#535353; display:inline-block; clear:both}
.road .roadC h3{ font-size:25px; color:#535353; font-family:"微软雅黑" ; font-weight:bold; margin-bottom:20px;}
.road .roadC p{line-height:1.8;}
.road .roadl1{ background:url(../images/line5.jpg) no-repeat left bottom;}
.road .roadl2{ background:url(../images/line6.jpg) no-repeat left bottom;}
.road .roadC p strong{ width:3px; height:3px; background-color:#666; display:inline-block; margin:0 5px 4px 0}
.road .roadfont{ text-align:center; padding:26px 0 0 0;}

