/*zhpmr*/
.zhpmr a{ display:inline-block; height:285px;}
.zhpmr a img{ width:502px; margin:0 auto; height:284px; position:absolute; left:132px; top:27px; z-index:1000; }
.zhpmr{border:#c6c6c6 solid 1px; float:left; display:inline; margin-top:7px; width:766px; text-align:center; padding-top:27px; position:relative;}
.zhpmr .zhpbtn{ height:110px; overflow:hidden; text-align:center;}
.zhpmr .zhpbtn a.zhpbtn1 { background:url(../images/zhpbtn1-2.jpg) no-repeat; width:166px; height:50px; margin-right:80px;bblr:expression(this.onFocus=this.blur());/*IE使用*/outline-style:none;/*FF使用*/}
.zhpmr .zhpbtn a:hover.zhpbtn1{ background:url(../images/zhpbtn1-1.jpg) no-repeat; width:166px; height:50px;}
.zhpmr .zhpbtn a.zhpbtn2{ background:url(../images/zhpbtn2-2.jpg) no-repeat; width:166px; height:50px; }
.zhpmr .zhpbtn a:hover.zhpbtn2{ background:url(../images/zhpbtn2-1.jpg) no-repeat; width:166px; height:50px;}
.zhpmr .zhpbtn a.zhpbtn1,.zhpmr .zhpbtn a.zhpbtn2{display:inline-block; border:none; margin-top:30px; cursor:pointer}
.zhpmr .zhpbtn a input{ display:none;}
.zhpmr ul{ padding:0 0 0 10px;}
.zhpmr ul.shbp{ padding:0 0 38px 0; display:none}
.zhpmr ul li{ height:200px; text-align:center; width:579px; display:inline-block; padding:38px 28px 0 32px; background-color:#f5f7f6; border:#dfdfdf solid 1px; margin-bottom:10px;}
.zhpmr ul li img{ float:left}
.zhpmr ul li p span{ width:326px; display:inline-block; text-align:left; padding:0 0 7px 6px; color:#535353; line-height:1.4;}
.zhpmr ul li p a.shpbtn{ background:url(../images/btn.jpg) no-repeat; width:75px; height:26px; line-height:26px; display:inline-block; color:#fff; text-align:center; margin:0 10px 0 0;}
.zhpmr ul li p a:hover.shpbtn{ background:url(../images/btn1.jpg) no-repeat; width:75px; height:26px;}
.zhpmr .shmore a{ color:#333; font-size:14px; text-align:center; height:15px; margin-bottom:30px; display:inline-block }
.zhpmr .shmore a:hover{color:#ea3535;}

