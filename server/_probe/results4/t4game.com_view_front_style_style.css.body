@charset "utf-8";
/* CSS Document */
HTML, body, div, span, object, iframe,h1, h2, h3, h4, h5, h6, a, address, big, cite, code,del, dfn, em, font, img, q, s, small, strong, b, u, i, dl, dt, dd, ol, ul, li,fieldset, form, label, table, caption, tbody, tfoot, thead, tr, th, td {margin:0; padding:0; border:0; font:12px \5b8b\4f53,Arial,sans-serif;_font-family:"SimSun";}
h1,h2,h3,h4,h5,h6{font-size:100%;}
address,caption,cite,code,dfn,em,th,var{font-style:normal;font-weight:normal;}
input,textarea{outline-style:none;-webkit-appearance:none;}
table{border-collapse:collapse;}
ol, ul{ list-style: none;}
img{border:none; color:#fff}
.fl{ float:left;}.fr{float:right;}
.cl{clear:both; height:0; font:0/0 Arial; visibility:hidden;}
a{text-decoration:none; color:#003366; bblr:expression(this.onFocus=this.blur());/*IE使用*/outline-style:none;/*FF使用*/}
a:hover{color:#990000; text-decoration:none }
.undis{ display:none}
.dis{ display:block}
body{ background:url(../images/bg.jpg) repeat-x top;}

.w980{ width:980px; margin:0 auto; overflow:hidden}
.c-head{ height:91px; padding:0 28px 0 14px;}
.c-head h1{ margin-top:36px; float:left}
.c-head h1 a{ background:url(../images/logo.png) no-repeat; width:386px; height:55px; display:inline-block}
.c-head ul.menu-tit{ float:right; background:url(../images/titbg.jpg) repeat-x; height:27px; border-top:none; border:#d3d3d3 solid 1px; border-left:none; line-height:27px;}
.c-head ul.menu-tit li{ float:left; color:#b6b6b6; display:inline-block}
.c-head ul.menu-tit li a,.c-head ul.menu-tit li a:hover{ color:#8b2200; padding:0 9px 0; display:inline-block;line-height:27px;}
.c-head ul.menu-tit li a:hover{ color:#ff3e00; text-decoration:none;}
.c-head ul.menu-tit li.menuLb{ border-left:#fff solid 1px; padding-left:10px;}
.c-head ul.menu-tit li.menuRb{ border-right:#fafafa solid 1px; padding-right:10px;}

/*nav*/
.nav{ height:39px; width:975px; margin:0 auto; padding-left:5px; }
.nav ul li{ float:left; color:#fff; font-size:12px; height:34px; line-height:34px; background:url(../images/line2.jpg) no-repeat right 9px; font-family:"微软雅黑"; position:relative; text-align:center; display:inline; }
.nav ul li a{ color:#fff; display:inline-block;font-family:"微软雅黑"; height:32px; padding-top:2px; line-height:34px; position:relative;}
.nav ul li a:hover,.nav ul li a.sel{ color:#8b2200; height:34px; line-height:28px; border:#8b2200 solid 1px; border-bottom:none; position:relative; top:1px;left:-1px;text-decoration:none; display:inline-block; background:#f1f1f1 url(../images/navBg.jpg) repeat-x bottom; position:relative; }
.nav ul li a:hover span,.nav ul li a.sel span{background:#f1f1f1;height:3px; display:inline-block; position:absolute; bottom:-2px; left:0px; z-index:1000}
.nav ul li.nav01,.nav ul li.nav01 a:hover,.nav ul li.nav01 a.sel,.nav ul li.nav01 a:hover span,.nav ul li.nav01 a.sel span{ width:81px; }
.nav ul li.nav02,.nav ul li.nav02 a:hover,.nav ul li.nav02 a.sel,.nav ul li.nav02 a:hover span,.nav ul li.nav02 a.sel span{ width:168px;}
.nav ul li.nav03,.nav ul li.nav03 a:hover,.nav ul li.nav03 a.sel,.nav ul li.nav03 a:hover span,.nav ul li.nav03 a.sel span{ width:131px;}
.nav ul li.nav04,.nav ul li.nav04 a:hover,.nav ul li.nav04 a.sel,.nav ul li.nav04 a:hover span,.nav ul li.nav04 a.sel span{ width:103px;}
.nav ul li.nav05,.nav ul li.nav05 a:hover,.nav ul li.nav05 a.sel,.nav ul li.nav05 a:hover span,.nav ul li.nav05 a.sel span{ width:103px;}
.nav ul li.nav06,.nav ul li.nav06 a:hover,.nav ul li.nav06 a.sel,.nav ul li.nav06 a:hover span,.nav ul li.nav06 a.sel span{ width:103px;}
.nav ul li.nav06{ background:none}

.tit{ padding:0 0 0 8px; font-weight:normal; height:34px; overflow:hidden }
.tit span{ background:url(../images/icon.png) no-repeat 0px 0px; width:17px; height:16px; display:inline-block; margin:8px 9px 0 0; float:left; cursor:pointer}
.tit a{ color:#6d6d6d; background:url(../images/dhbg.jpg) no-repeat 10px 1px; height:32px; line-height:3; display:inline-block; padding-left:35px; }
.tit a:hover{ color:#f60; text-decoration:none}
.banner{ width:980px; height:213px; margin:3px 0 8px 0; }

/*index*/
.indbannerbg{ background:url(../images/indbannerBg.png) no-repeat center bottom; padding-bottom:4px; margin-bottom:10px; margin:0 auto; text-align:center}
.a1{height:300px; margin:0 auto; width:100% }
.a4{display:none;}
.a4 span{ font-weight:bold; float:left; width:62px; height:113px; cursor:pointer; position:absolute; top:256px; z-index:100; }
.a4 span.pre{ background:url(../images/indlbtn.png) no-repeat; left:10px;}
.a4 span.next{ background:url(../images/indrbtn.png) no-repeat; right:10px;}
.a5{ position:relative;height:300px; overflow:hidden; width:100% }
.a6{  width:250000px; position:absolute; left:0px; }
.a6 ul li{ height:300px;float:left; width:100%; }
.a6 ul li img{ }

#left{background:url(../images/indlbtn.png) no-repeat; left:10px;width:62px; height:113px; cursor:pointer; position:absolute; top:256px; z-index:100;}
#right{background:url(../images/indrbtn.png) no-repeat; right:10px;width:62px; height:113px; cursor:pointer; position:absolute; top:256px; z-index:100;}

.newdt,.Product{ float:left; overflow:hidden; width:286px;}
.newdt h2,.Product h2{ background:url(../images/navbg1.jpg) repeat-x; height:23px; width:284px; border-bottom:#bebebe solid 2px; position:relative; border:#d96100 solid 1px; margin-top:11px;}
.newdt h2 img{ position:absolute; left:-3px; top:-9px; z-index:10}
.newdt h2 em,.Product h2 em{ background-color:#bebebe; width:286px; height:2px; position:absolute; bottom:-3px;_bottom:-4px; left:0px;overflow:hidden;}
.newdt h2 a,.newdt h2 a:hover,.Product h2 a,.Product h2 a:hover{ color:#fff; line-height:23px; float:right; margin-right:10px;}
.newdt ul{ margin:17px 0 0 8px;}
.newdt ul li{ border-bottom:#e3e3e3 dashed 1px; height:20px;_height:16px; padding:9px 0 0 0;*padding:7px 0 0 0;_padding:6px 0 0 0;  width:278px;color:#717171}
.newdt ul li span{ width:40px; border-right:#8b2200 solid 1px; height:13px; display:inline-block; color:#8b2200; margin:0 6px 0 0; float:left}
.newdt ul li span i{ width:2px; height:2px; background-color:#5a5a5a; display:inline-block; margin:5px 5px 3px 0; overflow:hidden; float:left }
.newdt ul li a.dtc1{ color:#717171;  width:225px; display:inline-block;white-space:nowrap; overflow:hidden;text-overflow:ellipsis; float:left}
.newdt ul li a.dtc1:hover{color:#8b2200;}
.newdt ul li span  a.dtc,.newdt ul li span  a:hover.dtc{ color:#8b2200;line-height:13px;}

/*Product*/
.Product{ margin:0 9px 0 9px; width:426px; float:left; height:280px;}
.Product h2{ width:424px;}
.Product h2 img{ position:absolute; left:10px; top:-12px; z-index:10}
.Product h2 em{ width:425px;overflow:hidden;}

.bd_expro{clear:both; margin:24px auto 0px;  background:url(../images/productBg.jpg) no-repeat; width:425px; height:194px; display:inline-block; position:relative; }
.bd_expro ul {position:absolute; top:-14px; left:21px;}
.bd_expro ul li{ position:relative; float:left;width:30px; height:203px; overflow:hidden; cursor:pointer}



/*joinUs*/
.joinUs{ float:left;}
.joinUs h2{background:url(../images/navbg2.jpg) repeat-x; height:23px; width:243px;  position:relative; border:#b2b2b2 solid 1px; margin:11px 0 4px;}
.joinUs h2 img{ position:absolute; left:9px; top:-10px;}
.joinUs h2 a,.joinUs h2 a:hover{ color:#525252; float:right; line-height:23px; margin-right:8px;}
.joinUs h2 em{background-color:#dedede; width:243px; height:1px; position:absolute; bottom:-2px; left:0px;overflow:hidden;}
.joinUs h3{ margin:5px 0 0 10px;}
.joinUs h3 a{ color:#828282; font-weight:bold; margin:7px 0 7px; display:inline-block;}
.joinUs h3 a:hover,.joinUs h3 a.JUsel{ color:#ec5a1d;}
.joinUs h3.bdT{ border-top:#cdcdcd solid 1px; width:232px; }
.joinUs p{ width:245px; display:inline-block; padding-left:5px; overflow:hidden; margin:0px;}
.joinUs p a{ color:#777;  margin-right:8px; display:inline-block; float:left; line-height:1.6; white-space:nowrap; letter-spacing:0.1px; }
.joinUs p a i{ width:2px; height:2px; background-color:#777;display:inline-block; margin:0 5px 3px 0;overflow:hidden;}
.joinUs p a:hover{ color:#8b2200; text-decoration:none}
.joinUs p a:hover i{ background-color:#8b2200; }

.bannerR img{ background:url(../images/bannerbg.jpg) no-repeat; width:237px; height:69px; padding:4px; float:left; margin-top:5px; }

/*left*/
.c-left{ width:205px; float:left; margin:0 7px 0 0; display:inline;  top:0px; z-index:1000;}
.c-left h3{ background:url(../images/titbg01.jpg) no-repeat; width:205px; height:35px; text-indent:-999px;}
.c-lef02 h3.titbg{ background:url(../images/titbg02.jpg) no-repeat;}
.c-left .c-left01{ border:#e5e5e5 solid 1px;  background:#f5f7f6; width:183px; height:321px; margin-top:8px; padding:24px 0 0 20px;}
.c-left .c-left01 ul li{ width:117px; height:39px; background:url(../images/line.jpg) no-repeat bottom; text-align:center; line-height:35px; position:relative;}
.c-left .c-left01 ul li a{ color:#535353; line-height:35px;}
.c-left .c-left01 ul li a i{ background:url(../images/icon.png) no-repeat -26px -5px; width:6px; height:11px; display:inline-block; margin-left:137px; position:absolute; right:-20px; top:12px; overflow:hidden}
.c-left .c-left01 ul li a:hover,.c-left .c-left01 ul li a.selL{ color:#fd6d17; text-decoration:none; overflow:hidden}
.c-left .c-left01 ul li a:hover i,.c-left .c-left01 ul li a.selL i{background:url(../images/icon.png) no-repeat -19px -5px; overflow:hidden}

/*zhaopin*/
.c-right{ border:#b4b4b4 solid 1px; width:706px; background:url(../images/cont-bg.jpg) no-repeat right top; float:right; display:inline; margin-top:7px; padding:0 0 50px 60px; position:relative; min-height:400px;height:expression_r(this.scrollHeight>400 ? "400px" ,"auto");}
.c-right .Add{ color:#4a4a4a; line-height:2; padding-top:26px;}
.c-right .Add a{ color:#4a4a4a;}
.c-right .Add a:hover{ color:#a40000;}
.c-right .Add a.ceob{ margin:5px 0 0 0; display:inline-block; background:url(../images/ceobtn3.jpg) no-repeat; width:84px; height:30px; color:#fff; text-align:center; line-height:30px; text-indent:-999; overflow:hidden}
.c-right .Add a:hover.ceob{ background:url(../images/ceobtn2.jpg) no-repeat;}
.c-right .dt{ border:#999 solid 1px; background:#e1e1e1; padding:5px; position:absolute; top:20px; left:40px; z-index:100; width:410px; display:none}
.c-right .dt a{ color:#333; font-weight:bold; float:right; margin-bottom:10px; }
.c-right ul.nav-btn{ clear:both; height:70px;}
.c-right ul.nav-btn li{ float:left;}
.c-right ul.nav-btn li a,.c-right ul.nav-btn li a:hover,.c-right ul.nav-btn li a.selBtn{ background:url(../images/btn.jpg) no-repeat; color:#fff; width:75px; height:26px; display:inline-block; text-align:center; line-height:26px; text-decoration:none; margin:30px 0 14px 0;}
.c-right ul.nav-btn li a.selBtn,.c-right ul.nav-btn li a:hover.mhove,.c-right ul.nav-btn li a:hover.mr{ background:url(../images/btn1.jpg) no-repeat;}
.c-right ul.nav-btn li a.mr,.c-right ul.nav-btn li a#tab1,.c-right ul.nav-btn li a#tab2,.c-right ul.nav-btn li a#tab3,.c-right ul.nav-btn li a#tab4{ margin-right:67px;}
.c-right .rcont{ border:#e0e0e0 solid 1px; background:#f5f7f6 url(../images/line1.jpg) repeat-x 0 0; width:602px; position:relative; padding:20px 0 23px 43px;}
.c-right .rcont em{ width:644px; border-bottom:#b0b0b0 solid 1px; display:inline-block; position:absolute; bottom:0px;_bottom:-1px; left:1px;overflow:hidden;}
.c-right .rcont img{ position:absolute; top:-6px; left:176px;}
.c-right .rcont ul li{ width:549px; border-bottom:#bcbcbc dashed 1px; padding:9px 0; display:inline-block; position:relative}
.c-right .rcont ul li i{background-image:url(../images/jia.jpg); background-repeat:no-repeat;  width:13px; height:13px; display:inline-block; cursor:pointer; position:absolute; left:10px; top:8px; float:left}
.c-right .rcont ul li i.selli{background-image:url(../images/jian.jpg);}
.c-right .rcont ul li span,.c-right .rcont ul li a{ float:left;display:inline-block;}
.c-right .rcont ul li span.li01{ width:84px; padding-left:35px; cursor:pointer}
.c-right .rcont ul li span.li01:hover,.c-right .rcont ul li span.li02:hover{ color:#a40000}
.c-right .rcont ul li span.li02{ width:289px; cursor:pointer}
.c-right .rcont ul li a.li03,.c-right .rcont ul li a:hover.li03{ width:138px; color:#000; float:right;}
.c-right .rcont ul li a:hover.li03{ color:#a40000}
.c-right .rcont ul li .zhz{  text-align:left; padding-left:40px; padding-top:10px; display:inline-block}
.c-right .rcont ul li .zhz p{ line-height:1.8; margin:0px;}
.c-right .rcont ul li .zhz strong{ font-weight:bold; margin-top:8px;display:inline-block; color:#df5c0d}
.c-right p.cl{ overflow:hidden; height:0px; display:none}
.c-right .rcont p.cl{ display:block} 

/*shengming*/
.shmtit{ background:url(../images/line3.jpg) repeat-x; border-left:#b2b2b2 solid 1px;border-right:#b2b2b2 solid 1px; height:26px; position:relative;}
.shmtit img{ position:relative; top:-4px; left:17px; }
.shmCont,.linkCont,.growupC{ width:878px; border:#d8d8d8 solid 1px; padding:43px 55px 26px 45px; position:relative;}
.shmCont h2{ background:url(../images/font.jpg) no-repeat; border-bottom:#d5d5d5 solid 1px; height:37px; margin-bottom:7px;}
.shmCont a,.newCont a.top,.zhpmr a.top{ background:url(../images/icon1.jpg) no-repeat; width:17px; height:25px; display:inline-block; position:absolute; bottom:5px; right:6px;}
.shmCont .shmCont1{ width:870px; margin:0 auto;} 
.shmCont .shmCont1 h3{ font-weight:bold; font-size:14px; color:#595757; margin:25px 0 0 0; display:inline-block}
.shmCont .shmCont1 p{ line-height:2; color:#595757; margin:10px 0 0 0;}


/*jianjie*/
.jj{ border:#c6c6c6 solid 1px; padding:35px 51px 56px 48px; width:667px; float:left; display:inline; margin-top:7px;}
.jj h2{ background:url(../images/font1.jpg) no-repeat; border-bottom:#d5d5d5 solid 1px; height:36px; clear:both; margin-bottom:25px;}
.jj p{ margin-top:10px; line-height:2; color:#535353}
.jj img{ margin:80px 0 0 0; float:right;}

/*jian hu*/
.jh{ border:#c6c6c6 solid 1px; padding:35px 41px 56px 48px;_padding:35px 49px 56px 48px; width:665px; float:left; display:inline; margin-top:7px;}
.jh h2{background:url(../images/font10.jpg) no-repeat; border-bottom:#d5d5d5 solid 1px; height:36px; clear:both; margin-bottom:25px;}
.jh p{ color:#535353; line-height:2.2; margin-top:10px;}
.jh p span{ color:#fd6d17;}
.jh p a,.jh p a:hover{ color:#8b2200}
.jh .jhbg{ width:606px; height:450px; background-color:#f5f7f6; border:#c6c6c6 solid 1px; padding:30px 30px 0;}
.jh .jhbg strong{ color:#fd6d17; font-weight:bold;}
.jh .jhfot{ padding-top:20px;}
.jh .jhfot p{ float:right; text-align:right;}
.jh .jhfot a,.jh .jhfot a:hover{ color:#fd6d17}

.jh h2.lch{background:url(../images/font11.jpg) no-repeat;}
.jh .lchC { padding:20px 0 0 0;}
.jh .lchC .lchCImg{ background-color:#efefef; padding:22px 28px 23px 26px; margin-bottom:66px;}

.jh h2.shq{background:url(../images/font12.jpg) no-repeat;}
.jh p.shqF strong{ color:#fd6d17; font-weight:bold;}

.jh h2.hsh{background:url(../images/font13.jpg) no-repeat; height:35px;}

.jh h2.jk{background:url(../images/font14.jpg) no-repeat; height:35px;}

.jh h2.faq{background:url(../images/font15.jpg) no-repeat; height:35px;}

.jh .faqList{ width:666px; margin:0 auto;}
.jh .faqList li{ border-bottom:#535353 dashed 1px;}
.jh .faqList li .faqtit{ color:#ff7910; margin-bottom:-2px;}
.jh .faqList li p{ line-height:1.5;}

/*link*/
.linkCont{ padding-bottom:36px; margin-top:7px;}
.linkCont h2{background:url(../images/font2.jpg) no-repeat; border-bottom:#d5d5d5 solid 1px; height:38px; margin-bottom:14px;}
.linkCont a{ float:left; width:121px; height:50px; display:inline-block; margin:19px 9px 0;}
.linkCont p{ margin:32px 0 0 19px;}


/*growup*/
.growupC{border:#c6c6c6 solid 1px; padding:16px 42px 46px 45px; width:679px; float:left; display:inline; margin-top:7px;}
.growupC h2.growupCtit1,.growupC h2.growupCtit2{  height:28px;border-bottom:#d5d5d5 solid 1px; margin-top:45px;}
.growupC h2.growupCtit1{background:url(../images/font3.jpg) no-repeat;}
.growupC h2.growupCtit2{background:url(../images/font4.jpg) no-repeat;}
.growupC img{ border:#d5d5d5 solid 1px; margin:28px 18px 0;}

/*Course*/
.Course{ padding:35px 50px 11px 45px;border:#c6c6c6 solid 1px; float:left; display:inline; height:580px; margin-top:7px; width:671px;}
.Course h2{ background:url(../images/font5.jpg) no-repeat; height:35px;border-bottom:#d5d5d5 solid 1px; margin-bottom:17px; }
.Course .Coursebg{ background:url(../images/pic11.jpg) no-repeat; width:666px; height:311px; border:#b4b4b4 solid 1px; position:relative;}
.Course .Coursebg em{ background:url(../images/yinying.jpg) no-repeat; width:667px; height:16px; display:inline-block; position:absolute; left:0px; bottom:-17px;}
.Course .Coursebg a{ display:inline-block;position:absolute;}
.Course .Coursebg a.fzh1{ left:59px; top:208px; width:43px; height:76px; }
.Course .Coursebg a.fzh2{ left:104px; top:164px; width:44px; height:96px; }
.Course .Coursebg a.fzh3{ left:161px; top:183px; width:44px; height:65px;}
.Course .Coursebg a.fzh4{ left:210px; top:129px; width:43px; height:81px;}
.Course .Coursebg a.fzh5{ left:261px; top:102px; width:43px; height:76px;}
.Course .CourseC{ border:#c3c3c3 solid 1px; width:583px;  margin:18px 0 0 0; padding:11px 20px 12px 62px; position:relative; background-color:#f5f7f6}
.Course .CourseC .icon4{ position:absolute; top:-8px; left:71px;}
.Course .CourseC em{ background:url(../images/icon3.jpg) no-repeat; width:54px; height:26px; display:inline-block; position:absolute; top:8px; left:-6px; color:#0f1342; line-height:23px; padding-left:6px;}
.Course .CourseC p{ color:#535353; line-height:2;}

/*contactus*/
.lxustit img{position:relative; top:-3px; left:17px; }
.lxusCont{padding:44px 55px 19px 46px;border:#c6c6c6 solid 1px; float:left; display:inline; margin-top:7px; width:877px;}
.lxusCont h2{background:url(../images/font6.jpg) no-repeat; height:37px;border-bottom:#d5d5d5 solid 1px; margin-bottom:17px;}
.lxusCont .Prompt{ background:url(../images/line4.jpg) no-repeat left bottom; height:27px; color:#6d6d6d}
.lxusCont .lxusfont{ line-height:2.5; color:#4a4a4a;}
.lxusCont .lxusfont a{ position:relative;}
.lxusCont .lxusfont a i{ background:url(../images/djdt.jpg) no-repeat 5px; width:28px; height:31px; display:inline-block; position:absolute; left:8px;}
.lxusCont .lxusfont em{ background:url(../images/map.jpg) no-repeat; width:708px; height:338px; position:relative;display:inline-block;}
.lxusCont .lxusfont em a{ position:absolute; left:322px; top:100px; display:inline-block; width:80px; height:30px;}
.lxusCont .lxusfont img{ border:#b7b7b7 solid 1px;}
.lxusCont .lxusfont a{color:#4a4a4a;}
.lxusCont .lxusfont a:hover{ color:#a40000; text-decoration:none}

/*culture*/
.wh{ border:#d5d5d5 solid 1px; width:978px; position:relative;}
.wh h2{ margin:36px 55px 28px 47px; display:inline-block; background:url(../images/font7.jpg) no-repeat; height:35px;border-bottom:#d5d5d5 solid 1px; width:876px;}
.wh .whC{ width:919px; padding:30px 0 50px 59px; display:inline-block} 
.wh .whC h3{ font-weight:bold; padding:25px 0 0 0; height:15px;  display:inline-block;}
.wh .whC p{ padding:5px 0 0 0; margin:0}

.wh .whC ul li { border:0; background-color: transparent; float:left; display:inline-block; margin:0 10px 10px 0;}
.wh .whC ul a{ display:inline-block; position:relative; z-index:0; text-decoration:none;float:left }
.wh .whC ul a div { position: absolute; top:0; left:0;}
.wh .whC ul a:hover div{ position: absolute; top:0; left:0;}
.wh .whC ul li a .liwhcx01{z-index: 2;transform-style: preserve-3d;backface-visibility: hidden;transition: -webkit-transform .2s linear;backface-visibility: hidden;  -webkit-transform-style: preserve-3d; -webkit-backface-visibility: hidden; -webkit-transition: -webkit-transform .3s linear; -moz-transform-style: preserve-3d; -moz-backface-visibility: hidden; -moz-transition: -moz-transform .3s linear; -o-transform-style: preserve-3d; -o-backface-visibility: hidden; -o-transition: -moz-transform .3s linear; }
.wh .whC ul li a:hover .liwhcx01{transform: rotateX(180deg);-webkit-transform: rotateX(180deg); -moz-transform: rotateX(180deg); -o-transform: rotateX(180deg); -ms-transform: rotateX(180deg); }
.wh .whC ul li a .liwhcx02{ z-index: 1;transform: rotateX(-180deg);transform-style: preserve-3d;backface-visibility: hidden; -webkit-transform: rotateX(-180deg); -webkit-transform-style: preserve-3d; -webkit-backface-visibility: hidden; -webkit-transition: -webkit-transform .3s linear; -moz-transform: rotateX(-180deg); -moz-transform-style: preserve-3d; -moz-backface-visibility: hidden; -moz-transition: -moz-transform .3s linear; -o-transform: rotateX(-180deg); -o-transform-style: preserve-3d; -o-backface-visibility: hidden; -o-transition: -o-transform .3s linear; -ms-transform: rotateX(-180deg); -ms-transform-style: preserve-3d; -ms-backface-visibility: hidden; -ms-transition: -ms-transform .5s linear; }
.wh .whC ul li a:hover .liwhcx02{ z-index: 3; zoom: 1;transform: rotateX(0deg); -webkit-transform: rotateX(0deg); -moz-transform: rotateX(0deg); -o-transform: rotateX(0deg); -ms-transform: rotateX(0deg); }


.wh .whC ul li a .liwhfx01 { z-index: 2;transform-style: preserve-3d;backface-visibility: hidden;transition: -webkit-transform .2s linear;  -webkit-transform-style: preserve-3d; -webkit-backface-visibility: hidden; -webkit-transition: -webkit-transform .2s linear; -moz-transform-style: preserve-3d; -moz-backface-visibility: hidden; -moz-transition: -moz-transform .2s linear; -o-transform-style: preserve-3d; -o-backface-visibility: hidden; -o-transition: -moz-transform .2s linear; }
.wh .whC ul li a .liwhfx02 { z-index: 1;transform: rotateY(-180deg);transform-style: preserve-3d; backface-visibility: hidden; -webkit-transform: rotateY(-180deg); -webkit-transform-style: preserve-3d; -webkit-backface-visibility: hidden; -webkit-transition: -webkit-transform .2s linear; -moz-transform: rotateY(-180deg); -moz-transform-style: preserve-3d; -moz-backface-visibility: hidden; -moz-transition: -moz-transform .2s linear; -o-transform: rotateY(-180deg); -o-transform-style: preserve-3d; -o-backface-visibility: hidden; -o-transition: -o-transform .2s linear; -ms-transform: rotateY(-180deg); -ms-transform-style: preserve-3d; -ms-backface-visibility: hidden; -ms-transition: -ms-transform .2s linear; }
.wh .whC ul li a:hover .liwhfx01{transform: rotateY(180deg);-webkit-transform: rotateY(180deg); -moz-transform: rotateY(180deg); -o-transform: rotateY(180deg); -ms-transform: rotateY(180deg); }
.wh .whC ul li a:hover .liwhfx02 { z-index: 3; zoom: 1;transform: rotateY(0deg); -webkit-transform: rotateY(0deg); -moz-transform: rotateY(0deg); -o-transform: rotateY(0deg); -ms-transform: rotateY(0deg); }



